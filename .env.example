# Copy file này thành .env rồi điền khóa. Không commit file .env.

# browser | fpt | azure
TTS_PROVIDER=browser

# FPT.AI (https://console.fpt.ai) - giọng: banmai, lannhi, leminh, myan, thuminh, giahuy, linhsan
FPT_API_KEY=
FPT_VOICE=banmai
FPT_SPEED=0

# Azure Speech - giọng: vi-VN-HoaiMyNeural (nữ), vi-VN-NamMinhNeural (nam)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_VOICE=vi-VN-HoaiMyNeural
AZURE_RATE=0%

PORT=3000
